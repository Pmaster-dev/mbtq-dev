# Server Environment Variables Example
# Copy this file to .env and update with your values

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://your-production-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database (Prisma)
DATABASE_URL=******host:5432/database
DIRECT_URL=******host:5432/database

# Auth Secrets — change ALL of these before deploying to production
CREATOR_JWT_SECRET=dev-creator-secret-change-in-prod
DEAFAUTH_JWT_SECRET=dev-deafauth-secret-change-in-prod
DEAFAUTH_JWT_EXPIRY=24h

# Optional: Redis connection (for caching/rate limiting)
REDIS_URL=redis://localhost:6379

# Optional: Supabase (legacy webhooks layer)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Monitoring
SENTRY_DSN=your-backend-sentry-dsn

# Logging
LOG_LEVEL=info
