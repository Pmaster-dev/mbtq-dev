# Deaf First API — Environment Variables
# Copy to .env and fill in your values. Never commit the real .env file.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
PYTHONPATH=/app

# ── CORS — comma-separated allowed origins (use * only for local dev) ─────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── DeafAUTH ─────────────────────────────────────────────────────────────────
DEAFAUTH_JWT_SECRET=dev-deafauth-secret-change-in-prod
# Minimum FibonRose trust score to access protected endpoints (0.0 – 1.0)
DEAFAUTH_MIN_TRUST=0.5

# ── SignAI provider selection ─────────────────────────────────────────────────
# Preferred primary provider: aws | azure | google | openai | local
# If unset, the first configured cloud provider is used; local is always the fallback.
SIGNAI_PRIMARY_PROVIDER=local

# Optional allow-list (comma-separated). Remove to enable all.
# SIGNAI_ENABLE_PROVIDERS=aws,azure,local

# Number of frames to buffer before a WebSocket stream result is emitted
SIGNAI_STREAM_BUFFER=30

# Path to a pre-trained local .pth model (optional)
# SIGNAI_LOCAL_MODEL_PATH=models/signlang_transformer.pth
# SIGNAI_LOCAL_DB_PATH=signai_local.db

# ── AWS Rekognition + SageMaker ───────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_SAGEMAKER_ENDPOINT=my-asl-endpoint   (optional custom model)

# ── Azure Cognitive Services ──────────────────────────────────────────────────
# AZURE_VISION_KEY=
# AZURE_VISION_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# ── Google Cloud Vision / Video Intelligence ──────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=my-project-id
# GOOGLE_CLOUD_REGION=us-central1
# VERTEX_ENDPOINT_ID=                      (optional Vertex AI endpoint)

# ── OpenAI GPT-4o Vision ──────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_FRAMES=8
